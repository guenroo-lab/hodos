// Backend.gs — punto de entrada y lógica de registro de lotes.

function doGet(e) {
  var params = (e && e.parameter) || {};
  // Centinela (2026-09-21): lectura JSON de los pendientes de una tienda, sin tocar la vista HTML.
  if (params.accion === 'pendientesTienda') return respuestaPendientesTienda_(params.tienda);
  var tmpl = HtmlService.createTemplateFromFile('Index');
  tmpl.vista = validarVista(params.vista);
  tmpl.tiendaFiltro = validarTienda(params.tienda);
  // Contexto opcional para la vista "operario" (llegada cruzada desde Carta de Portes
  // SIE): fecha/horario no se validan contra una lista fija (la fecha es libre y el
  // horario depende de la tienda), pero <?= ?> los escapa igual al templar, así que es
  // seguro pasarlos tal cual, solo recortando espacios.
  tmpl.fechaContexto = String(params.fecha || '').trim();
  tmpl.horarioContexto = String(params.horario || '').trim();
  return tmpl.evaluate()
    .setTitle('HODOS - Taisa Logistics')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    // Permite embeber HODOS en un <iframe> de otra app propia (Panel
    // Arrastres, pestaña "Hodos", 2026-09-09) — sin esto algunos navegadores
    // bloquean el framing por defecto.
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function registrarLote(datos) {
  var lineas = parsearLotePedidos(datos.pedidosTexto);
  if (lineas.length === 0) {
    throw new Error('No hay pedidos en la lista');
  }
  if (!datos.origen) throw new Error('Falta el origen');
  if (datos.origen === 'Taisa' && !datos.subtipo) throw new Error('Falta el subtipo de Taisa');
  if (!datos.destino) throw new Error('Falta la tienda destino');
  // Bug real (2026-09-23, revisión de seguridad): solo se comprobaba que destino no
  // viniera vacío, nunca contra TIENDAS_VALIDAS (a diferencia de origenTienda en una
  // Cesión, donde justo este mismo tipo de bug ya se corrigió una vez — ver
  // validarCesionEntreTiendas más abajo). Un destino con un valor no reconocido
  // (typo, o una integración futura sin normalizar) crea un soporte huérfano: invisible
  // en la pestaña Pendientes (obtenerPendientesPorTienda solo expone las 4 tiendas de
  // TIENDAS_VALIDAS) y en el filtro de destino del Buscador Interno.
  if (!validarTienda(datos.destino)) throw new Error('La tienda destino no es válida: "' + datos.destino + '"');

  var subtipo = subtipoEfectivo(datos.origen, datos.subtipo);
  var origenTienda = '';
  if (datos.origen === 'Cesión') {
    var validacionCesion = validarCesionEntreTiendas(datos.origenTienda, datos.destino);
    if (!validacionCesion.ok) {
      throw new Error(mensajeCesionInvalida_(validacionCesion.motivo));
    }
    origenTienda = validarTienda(datos.origenTienda);
  }
  var origenTexto = formatearOrigenTexto(datos.origen, datos.origen === 'Cesión' ? origenTienda : subtipo);
  // Línea de abajo opcional por etiqueta (arrastres de Antequera: "PED. PROV. 81406165"), alineada 1:1 con las
  // líneas del lote. Se guarda tras " · " en origenTexto (sin columna nueva) y htmlUnaEtiqueta_ la pinta aparte.
  var sufijosOrigen = (Array.isArray(datos.sufijosOrigen) && datos.sufijosOrigen.length === lineas.length) ? datos.sufijosOrigen : [];
  var soportes = calcularSoportes(lineas);
  var ids = siguienteBloqueIdsEtiquetas_(lineas.length);
  var loteId = Utilities.getUuid();
  var fecha = new Date().toISOString();
  var creadoPor = datos.creadoPor || (Session.getActiveUser().getEmail() || 'desconocido');

  var razonFlujo = razonFlujoEfectiva(datos.origen, datos.razonFlujo);

  var filas = soportes.map(function (s, i) {
    return {
      idUnico: ids[i], numeroPedido: s.numeroPedido, soporteNum: s.soporteNum, soporteTotal: s.soporteTotal,
      origen: datos.origen, subtipo: subtipo, origenTexto: origenTextoConSufijo(origenTexto, sufijosOrigen[i]), destino: datos.destino,
      fechaCreacion: fecha, loteId: loteId, creadoPor: creadoPor, estado: 'REGISTRADO',
      bateaId: null, fechaEnvio: null, origenTienda: origenTienda, razonFlujo: razonFlujo,
      // Solo la usa la integración de arrastres (MacroArrastres), para poder distinguir
      // dos entregas del mismo pedido el mismo día. Las altas normales no la mandan ->
      // se guarda null, no cadena vacía, para que el filtro "expedicion=eq.X" nunca las
      // confunda con nada.
      expedicion: datos.expedicion || null
    };
  });

  insertarEtiquetas_(filas);

  var items = soportes.map(function (s, i) {
    return { idUnico: ids[i], numeroPedido: s.numeroPedido, soporteNum: s.soporteNum, soporteTotal: s.soporteTotal };
  });

  return { loteId: loteId, cantidad: filas.length, ids: ids, items: items };
}

// ── Contenido opcional por soporte (artículos/cantidades, no afecta a la etiqueta) ──

function guardarContenidoSoporte(idUnico, items, creadoPorOverride) {
  if (!idUnico) throw new Error('Falta el idUnico');
  var lineas = prepararLineasContenido(items);
  borrarContenidoPorIdUnico_(idUnico);
  if (lineas.length === 0) return { idUnico: idUnico, cantidad: 0 };
  var creadoPor = creadoPorOverride || (Session.getActiveUser().getEmail() || 'desconocido');
  insertarContenido_(idUnico, lineas, creadoPor);
  return { idUnico: idUnico, cantidad: lineas.length };
}

function agruparContenidoPorIdUnico_(filas) {
  var mapa = {};
  filas.forEach(function (f) {
    if (!mapa[f.id_unico]) mapa[f.id_unico] = [];
    mapa[f.id_unico].push({ descripcion: f.descripcion, cantidad: f.cantidad });
  });
  return mapa;
}

function obtenerMapaContenido_() {
  return agruparContenidoPorIdUnico_(leerTodoContenidoCrudo_());
}

// ── Fase 2 del recorte de egress (2026-10-06) ──
// Medido el 06/10 en los logs de Supabase: buscarEtiquetas, obtenerCarga y cerrarCarga
// bajaban la tabla `etiquetas` ENTERA (~6.200 filas, 7 viajes), `contenido` entera
// (~2.000) y `cargas` entera en cada llamada para quedarse con unas pocas filas:
// ~850.000 filas de etiquetas al día, ~75 % de lo que sale de Supabase hacia HODOS.
// Ahora cada una pide solo lo que usa. Los mapas se construyen SOLO para las etiquetas
// que superan el filtro; si fueran muchísimas (búsqueda sin criterios) se vuelve a la
// lectura entera de antes, que en ese caso cuesta menos viajes que cientos de lotes.
var MAX_IDS_MAPA_CONTENIDO_ = 400;
var MAX_IDS_MAPA_CARGAS_ = 80;
var LOTE_IDS_CARGAS_ = 40;

function obtenerMapaContenidoDe_(idsUnico) {
  var ids = distintosTexto_(idsUnico);
  if (ids.length === 0) return {};
  if (ids.length > MAX_IDS_MAPA_CONTENIDO_) return obtenerMapaContenido_();
  return agruparContenidoPorIdUnico_(leerContenidoCrudoPorIds_(ids));
}

function obtenerMapaCargasDe_(idsCarga) {
  var ids = distintosTexto_(idsCarga);
  if (ids.length === 0) return {};
  if (ids.length > MAX_IDS_MAPA_CARGAS_) return obtenerMapaCargas_();
  var mapa = {};
  for (var i = 0; i < ids.length; i += LOTE_IDS_CARGAS_) {
    var trozo = ids.slice(i, i + LOTE_IDS_CARGAS_);
    leerCargas_('id_carga=in.(' + trozo.map(function (id) { return encodeURIComponent(id); }).join(',') + ')').forEach(function (f) {
      mapa[f.idCarga] = { fechaEntrega: fechaComoTexto(f.fechaEntrega), horario: f.horario };
    });
  }
  return mapa;
}

function obtenerHistorialLotes(limite) {
  limite = limite || 10;
  // Solo las 4 columnas que usa el cálculo de abajo (el resto de la etiqueta no se descarga).
  var filas = leerEtiquetas_('order=fecha_creacion.asc', 'lote_id,origen_texto,destino,fecha_creacion');
  var porLote = {};
  var orden = [];
  filas.forEach(function (f) {
    if (!porLote[f.loteId]) {
      porLote[f.loteId] = { loteId: f.loteId, cantidad: 0, origenTexto: f.origenTexto, destino: f.destino, fecha: fechaComoTexto(f.fechaCreacion) };
      orden.push(f.loteId);
    }
    porLote[f.loteId].cantidad++;
  });
  return orden.slice(-limite).reverse().map(function (id) { return porLote[id]; });
}

// ── Generación del HTML de etiquetas para impresión (siempre en servidor: ver
// CLAUDE.md, regla de oro heredada de lm_producción) ──

var LOGO_TAISA_B64 = '';
var LOGO_LM_B64 = '';

function esc_(valor) {
  return String(valor)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

function obtenerEtiquetasPorLote_(loteId) {
  return leerEtiquetas_('lote_id=eq.' + encodeURIComponent(loteId) + '&order=soporte_num.asc');
}

// El origen de la etiqueta ("ANTEQUERA") puede llevar detrás " · " + una línea de abajo (nº de pedido proveedor).
// Sin ella el HTML es exactamente el de siempre; con ella, las dos líneas van juntas en un único bloque (la etiqueta
// reparte sus hijos con space-between, así que separadas quedarían alejadas).
function origenInfoHtml_(origenTexto) {
  var partes = String(origenTexto == null ? '' : origenTexto).split(SEPARADOR_SUFIJO_ORIGEN_);
  if (partes.length < 2) return '<div class="origen-info">' + esc_(origenTexto) + '</div>';
  return '<div class="origen-bloque"><div class="origen-info">' + esc_(partes[0]) + '</div>' +
    '<div class="origen-prov">' + esc_(partes.slice(1).join(SEPARADOR_SUFIJO_ORIGEN_)) + '</div></div>';
}

function htmlUnaEtiqueta_(e, fechaTxt) {
  // El barcode codifica el idUnico (único SIEMPRE, por fila/soporte), no el número de
  // pedido: así cada etiqueta física es inequívoca al escanear (ver seleccionarSoporteAEscanear
  // en Utilidades.gs) y una etiqueta agrupada (varios pedidos con "+") puede tener un
  // único barcode aunque no haya "un" número de pedido que la identifique.
  var barcodeSvg = code128SVG(String(e.idUnico), { anchoModulo: 2, alto: 60 });
  var pedidos = tokensPedido_(e.numeroPedido);
  var esGrupo = pedidos.length > 1;
  // Grupos grandes (más de UMBRAL_AGRUPACION_ETIQUETA_ pedidos) no caben apilados en la
  // etiqueta física — lineasNumeroPedidoEtiqueta (Utilidades.gs) los resume como
  // "AGRUPACIÓN (N)" en vez de listarlos todos. El barcode sigue codificando idUnico
  // (no numeroPedido), así que el soporte se identifica igual de bien escaneando.
  // Grupo de 4-5 pedidos CON línea de abajo (nº de pedido proveedor): no cabe con el interlineado normal (sobraban 3 mm),
  // así que solo en ese caso se compacta. Sin línea de abajo la etiqueta es exactamente la de siempre.
  var conProv = String(e.origenTexto == null ? '' : e.origenTexto).indexOf(SEPARADOR_SUFIJO_ORIGEN_) >= 0;
  var compacto = esGrupo && conProv && pedidos.length >= 4 && pedidos.length <= UMBRAL_AGRUPACION_ETIQUETA_;
  var numeroPedidoHtml = '<div class="numero-pedido-h' + (esGrupo ? ' numero-pedido-grupo' : '') + (compacto ? ' con-prov' : '') + '">' +
    lineasNumeroPedidoEtiqueta(pedidos).map(esc_).join('<br>') + '</div>';
  // El badge de soporte SOLO se muestra si el pedido (no agrupado) tiene más de un
  // soporte en este lote — las etiquetas agrupadas NUNCA llevan badge de soporte
  // (decisión explícita: un grupo es una pieza única aunque el mismo grupo se repita).
  var soporteHtml = (!esGrupo && e.soporteTotal > 1)
    ? '<div class="soporte-badge">SOPORTE ' + esc_(e.soporteNum) + '/' + esc_(e.soporteTotal) + '</div>'
    : '';
  var logoLmHtml = LOGO_LM_B64
    ? '<img src="data:image/png;base64,' + LOGO_LM_B64 + '" class="logo-lm">'
    : '';
  return '' +
    '<div class="etiqueta-wrapper"><div class="etiqueta">' +
    '<div class="etiqueta-top">' +
    '<img src="data:image/png;base64,' + LOGO_TAISA_B64 + '" class="logo-taisa">' +
    '<div class="fecha-id">Creada: ' + esc_(fechaTxt) + '<div class="id-unico">' + esc_(e.idUnico) + '</div></div>' +
    '</div>' +
    '<div class="tienda-destino">' + esc_(e.destino) + '</div>' +
    numeroPedidoHtml +
    soporteHtml +
    origenInfoHtml_(e.origenTexto) +
    '<div class="etiqueta-bottom">' + logoLmHtml + '<div class="barcode-wrap">' + barcodeSvg + '</div></div>' +
    '</div></div>';
}

function htmlEtiquetas(loteId) {
  var etiquetas = obtenerEtiquetasPorLote_(loteId);
  if (etiquetas.length === 0) throw new Error('Lote no encontrado: ' + loteId);
  var tarjetas = etiquetas.map(function (e) {
    var fechaTxt = Utilities.formatDate(new Date(e.fechaCreacion), 'GMT+1', 'dd/MM/yyyy');
    return htmlUnaEtiqueta_(e, fechaTxt);
  }).join('\n');
  return envolverEtiquetasHtml_(tarjetas);
}

// Reimpresión de una sola etiqueta (admin, Buscador Interno) — mismo HTML/CSS que el
// lote (envolverEtiquetasHtml_), pero para un único idUnico. No depende del estado del
// soporte: reimprimir es de solo lectura, no cambia nada en Supabase, así que tiene
// sentido incluso para un soporte ya cargado en un camión (etiqueta perdida/dañada).
function htmlEtiquetaUnica(idUnico) {
  if (!idUnico) throw new Error('Falta el idUnico');
  var filas = leerEtiquetas_('id_unico=eq.' + encodeURIComponent(idUnico));
  if (filas.length === 0) throw new Error('Etiqueta no encontrada: ' + idUnico);
  var e = filas[0];
  var fechaTxt = Utilities.formatDate(new Date(e.fechaCreacion), 'GMT+1', 'dd/MM/yyyy');
  return envolverEtiquetasHtml_(htmlUnaEtiqueta_(e, fechaTxt));
}

function envolverEtiquetasHtml_(tarjetas, estiloExtra) {
  var estilo = [
    // El driver de la Zebra ignora la orientación pedida por CSS y usa el tamaño
    // NATIVO del rollo para la página (confirmado en real en
    // robot-ubicacion-pyxis/App.html: sin esto, la etiqueta sale girada y cortada).
    // Se declara @page en las dimensiones intercambiadas (100x150, "vertical" según
    // el rollo) y se rota el CONTENIDO 90° dentro para que se lea apaisado.
    '@page{size:100mm 150mm;margin:0;}',
    'body{margin:0;padding:0;background:#fff;font-family:Arial,sans-serif;}',
    // Antes: .etiqueta con position:absolute + left/top:50% + translate(-50%,-50%).
    // Ese % de left/top se resuelve contra el tamaño del contenedor en CADA página del
    // trabajo de impresión, y en lotes de varias etiquetas Chrome lo ha resuelto mal en
    // páginas concretas (una de cada bloque salía descuadrada/cortada, el resto bien) —
    // pinta a bug de paginación de impresión con % en absolute repetido muchas veces en
    // el mismo documento. Centrado por flexbox en su lugar: no depende de resolver un %
    // de posición por página, solo de flex centrando un único hijo de tamaño fijo.
    '.etiqueta-wrapper{width:100mm;height:150mm;overflow:hidden;page-break-after:always;',
    'display:flex;align-items:center;justify-content:center;}',
    '.etiqueta{width:150mm;height:100mm;flex:none;transform:rotate(90deg);',
    'padding:5mm 8mm;border:2px solid #000;',
    'display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box;}',
    '.etiqueta-top{display:flex;justify-content:space-between;align-items:flex-start;}',
    '.logo-taisa{height:12mm;width:auto;}',
    '.fecha-id{text-align:right;font-size:9px;color:#333;}',
    '.fecha-id .id-unico{font-weight:bold;font-size:10px;margin-top:1mm;}',
    '.tienda-destino{font-size:30px;font-weight:900;text-transform:uppercase;text-align:center;}',
    '.numero-pedido-h{font-size:46px;font-weight:900;text-align:center;letter-spacing:2mm;}',
    '.numero-pedido-h.numero-pedido-grupo{font-size:22px;letter-spacing:1mm;line-height:1.3;}',
    '.numero-pedido-h.numero-pedido-grupo.con-prov{line-height:1.15;}',
    '.soporte-badge{font-size:14px;font-weight:700;text-align:center;color:#333;margin-top:-2mm;}',
    '.origen-info{font-size:26px;font-weight:900;color:#e30613;text-transform:uppercase;text-align:center;}',
    '.origen-prov{font-size:15px;font-weight:700;color:#333;text-transform:uppercase;text-align:center;margin-top:1mm;}',
    '.etiqueta-bottom{display:flex;align-items:center;justify-content:space-between;}',
    '.logo-lm{height:10mm;width:auto;}',
    '.barcode-wrap{flex:1;display:flex;justify-content:center;}'
  ].join('');

  var partes = [];
  partes.push('<' + '!DOCTYPE html>');
  partes.push('<html><head><meta charset="UTF-8">');
  partes.push('<' + 'style>' + estilo + (estiloExtra || '') + '<' + '/style>');
  partes.push('</head><body>');
  partes.push(tarjetas);
  partes.push('</body></html>');
  return partes.join('');
}

// ── Búsqueda de solo lectura (vistas interno/tienda) ──

function obtenerMapaCargas_() {
  var filas = leerCargas_(null);
  var mapa = {};
  filas.forEach(function (f) {
    mapa[f.idCarga] = { fechaEntrega: fechaComoTexto(f.fechaEntrega), horario: f.horario };
  });
  return mapa;
}

// Pre-filtro PostgREST de buscarEtiquetas (Fase 2 del recorte de egress, 2026-10-06).
// SOBRE-APROXIMA a propósito: nunca deja fuera una fila que el filtro JS de
// buscarEtiquetas aceptaría (ilike es insensible a mayúsculas e indexOf no; la fecha
// lleva un día de margen por cada lado). El filtro JS sigue decidiendo de verdad. Un
// criterio con caracteres que podrían romper un `ilike`/`or(...)` (comodines, comas,
// paréntesis, barras) NO se empuja al servidor: esa búsqueda lee más, pero nunca mal.
function filtroPrevioBuscarEtiquetas_(filtros) {
  var partes = [];
  var SEGURO_ID = /^[A-Za-z0-9 _.+\-]+$/;
  var SEGURO_PEDIDO = /^[A-Za-z0-9+\-]+$/;
  if (filtros.destino) partes.push('destino=eq.' + encodeURIComponent(filtros.destino));
  if (filtros.origen) partes.push('origen=eq.' + encodeURIComponent(filtros.origen));
  if (filtros.estado) partes.push('estado=eq.' + encodeURIComponent(filtros.estado));
  if (filtros.idUnico && SEGURO_ID.test(String(filtros.idUnico))) {
    partes.push('id_unico=ilike.' + encodeURIComponent('*' + String(filtros.idUnico) + '*'));
  }
  if (filtros.numeroPedido) {
    var tokens = parsearLotePedidos(filtros.numeroPedido);
    if (tokens.length >= 1 && tokens.length <= 20 && tokens.every(function (t) { return SEGURO_PEDIDO.test(t); })) {
      var condiciones = tokens.map(function (t) { return 'numero_pedido.ilike.' + encodeURIComponent('*' + t + '*'); });
      partes.push(condiciones.length === 1 ? 'numero_pedido=ilike.' + encodeURIComponent('*' + tokens[0] + '*') : 'or=(' + condiciones.join(',') + ')');
    }
  }
  if (filtros.pendienteImpresionIncpc === true) partes.push('pendiente_impresion_incpc=eq.true');
  if (filtros.fecha && /^\d{4}-\d{2}-\d{2}$/.test(String(filtros.fecha))) {
    var p = String(filtros.fecha).split('-');
    var dia = Date.UTC(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
    var DIA_MS = 24 * 3600 * 1000;
    partes.push('fecha_creacion=gte.' + encodeURIComponent(new Date(dia - DIA_MS).toISOString()));
    partes.push('fecha_creacion=lt.' + encodeURIComponent(new Date(dia + DIA_MS).toISOString()));
  }
  return partes.join('&');
}

function buscarEtiquetas(filtros) {
  filtros = filtros || {};
  // order=id_unico.asc (no null): un id_unico correlativo por secuencia da un orden
  // estable entre páginas de supaGet_ — sin esto, un borrado concurrente (p.ej.
  // "Borrar seleccionados" en el propio Buscador Interno) mientras se pagina la tabla
  // completa puede desplazar filas y saltarse una entre dos peticiones (ver v48/v49 en
  // CLAUDE.md y SupabaseCliente.gs).
  // Fase 2 (2026-10-06): con criterios, solo se piden las filas que podrían cumplirlos
  // (filtroPrevioBuscarEtiquetas_); y las cargas/contenido, solo de las que salen.
  var filtroServidor = filtroPrevioBuscarEtiquetas_(filtros);
  var filas = leerEtiquetas_('order=id_unico.asc' + (filtroServidor ? '&' + filtroServidor : ''));

  var pasan = filas.filter(function (f) {
    if (filtros.destino && f.destino !== filtros.destino) return false;
    if (filtros.origen && f.origen !== filtros.origen) return false;
    if (filtros.estado && f.estado !== filtros.estado) return false;
    if (filtros.idUnico && String(f.idUnico).indexOf(filtros.idUnico) === -1) return false;
    if (filtros.numeroPedido) {
      var pedidosBuscados = parsearLotePedidos(filtros.numeroPedido);
      var coincideAlguno = pedidosBuscados.some(function (p) { return String(f.numeroPedido).indexOf(p) !== -1; });
      if (!coincideAlguno) return false;
    }
    if (filtros.pendienteImpresionIncpc !== undefined && !!f.pendienteImpresionIncpc !== filtros.pendienteImpresionIncpc) return false;
    if (filtros.fecha) {
      var fechaFila = Utilities.formatDate(new Date(f.fechaCreacion), 'GMT+1', 'yyyy-MM-dd');
      if (fechaFila !== filtros.fecha) return false;
    }
    return true;
  });

  var mapaCargas = obtenerMapaCargasDe_(pasan.map(function (f) { return f.bateaId; }));
  var mapaContenido = obtenerMapaContenidoDe_(pasan.map(function (f) { return f.idUnico; }));

  var resultado = pasan.map(function (f) {
    var carga = f.bateaId ? mapaCargas[f.bateaId] : null;
    return {
      idUnico: f.idUnico, numeroPedido: f.numeroPedido, soporteNum: f.soporteNum, soporteTotal: f.soporteTotal,
      origen: f.origen, subtipo: f.subtipo, origenTienda: f.origenTienda, razonFlujo: f.razonFlujo,
      origenTexto: f.origenTexto, destino: f.destino, fechaCreacion: fechaComoTexto(f.fechaCreacion),
      // Expedición (solo la mandan las integraciones de arrastres) y quién creó la etiqueta: Panel Arrastres
      // agrupa su listado de Hodos por expedición. Siempre texto ('' si no hay), nunca null.
      expedicion: f.expedicion || '', creadoPor: f.creadoPor || '',
      estado: f.estado, bateaId: f.bateaId, fechaCargado: fechaComoTexto(f.fechaEnvio),
      fechaLlegada: carga ? carga.fechaEntrega : '', horarioLlegada: carga ? carga.horario : '',
      contenido: mapaContenido[f.idUnico] || []
    };
  });

  var signo = filtros.ordenAscendente ? 1 : -1;
  resultado.sort(function (a, b) { return signo * (new Date(a.fechaCreacion) - new Date(b.fechaCreacion)); });
  return resultado;
}

// ── Pestaña "Pendientes": soportes "vivos" (REGISTRADO, aún no cargados en ningún
// camión) agrupados por tienda destino, para priorizar qué buscar y cargar. ──

var UMBRAL_ALERTA_HORAS_ = 30;

function obtenerPendientesPorTienda() {
  // order=fecha_creacion.asc: el más antiguo primero dentro de cada tienda, que es
  // justo el orden en que interesa revisarlos (los que más alerta necesitan arriba).
  var filas = leerEtiquetas_('estado=eq.REGISTRADO&order=fecha_creacion.asc');
  var ahora = new Date();
  var porTienda = {};
  TIENDAS_VALIDAS.forEach(function (t) { porTienda[t] = []; });

  filas.forEach(function (f) {
    var horas = horasLaborablesTranscurridas(f.fechaCreacion, ahora);
    var nivelAviso = nivelAvisoPorHoras(horas, UMBRAL_ALERTA_HORAS_);
    var item = {
      idUnico: f.idUnico, numeroPedido: f.numeroPedido, soporteNum: f.soporteNum, soporteTotal: f.soporteTotal,
      origenTexto: f.origenTexto, razonFlujo: f.razonFlujo, fechaCreacion: fechaComoTexto(f.fechaCreacion),
      horasTranscurridas: Math.round(horas * 10) / 10,
      nivelAviso: nivelAviso,
      alerta: nivelAviso === 'rojo'
    };
    if (!porTienda[f.destino]) porTienda[f.destino] = [];
    porTienda[f.destino].push(item);
  });

  return TIENDAS_VALIDAS.map(function (t) {
    var pendientes = porTienda[t];
    return {
      tienda: t,
      pendientes: pendientes,
      totalAlertas: pendientes.filter(function (x) { return x.alerta; }).length
    };
  });
}

// ── Administración: borrar/editar un soporte, solo mientras no se haya cargado en
// ningún camión (REGISTRADO) — una vez escaneado en una carga, protegido para no
// descuadrar cargas ya en curso o informes ya enviados (ver CLAUDE.md). ──

function borrarSoporteAdmin(idUnico) {
  if (!idUnico) throw new Error('Falta el idUnico');
  var filas = leerEtiquetas_('id_unico=eq.' + encodeURIComponent(idUnico));
  if (filas.length === 0) throw new Error('No existe ese soporte: ' + idUnico);
  if (filas[0].estado !== 'REGISTRADO') throw new Error('Solo se puede borrar un soporte que aún no se ha cargado en un camión');
  borrarEtiquetaPorIdUnico_(idUnico);
  return { ok: true };
}

// Borrado masivo: reutiliza borrarSoporteAdmin por cada idUnico (misma guarda de
// estado) en vez de repetir la lógica — un fallo en uno no aborta el resto, se
// reporta aparte para que la interfaz pueda avisar qué no se pudo borrar y por qué.
function borrarSoportesAdmin(idsUnicos) {
  if (!idsUnicos || idsUnicos.length === 0) throw new Error('No hay soportes seleccionados');
  var borrados = [];
  var rechazados = [];
  idsUnicos.forEach(function (idUnico) {
    try {
      borrarSoporteAdmin(idUnico);
      borrados.push(idUnico);
    } catch (e) {
      rechazados.push({ idUnico: idUnico, motivo: e.message });
    }
  });
  return { borrados: borrados, rechazados: rechazados };
}

// Agrupar soportes YA EXISTENTES (selección múltiple en Interno/INCPC/Preparación) en
// una etiqueta nueva — reglas de compatibilidad en validarAgrupacion (Utilidades.gs).
// Orden de operaciones: 1) crear la etiqueta nueva, 2) copiar el contenido combinado,
// 3) avisar a INCPC por cada original que viniera de esa integración (best-effort, no
// bloqueante — decisión explícita del usuario: si INCPC no responde, la agrupación
// sigue adelante y el aviso vuelve en avisosIncpc para corregir la hoja a mano), 4)
// borrar los originales. El contenido se lee ANTES de borrar (ON DELETE CASCADE en
// Supabase se lo llevaría con la etiqueta original).
function agruparSoportesAdmin(idsUnicos) {
  if (!idsUnicos || idsUnicos.length < 2) throw new Error('Selecciona al menos 2 soportes para agrupar');

  var filtro = 'id_unico=in.(' + idsUnicos.map(function (id) { return encodeURIComponent(id); }).join(',') + ')';
  var filas = leerEtiquetas_(filtro);
  if (filas.length !== idsUnicos.length) {
    throw new Error('Alguno de los soportes seleccionados ya no existe — vuelve a buscar y prueba de nuevo');
  }

  var validacion = validarAgrupacion(filas);
  if (!validacion.ok) throw new Error(validacion.motivo);

  // El subtipo NO forma parte de las reglas de compatibilidad (decisión explícita del
  // usuario, 2026-08-21) — dos soportes Taisa con subtipos distintos sí se pueden
  // agrupar. La etiqueta nueva hereda sin más el subtipo/origenTexto del PRIMER
  // soporte seleccionado; no es una fusión de los subtipos de todos.
  var primero = filas[0];
  var numeroPedido = numeroPedidoAgrupado(filas);
  var idNuevo = siguienteBloqueIdsEtiquetas_(1)[0];
  var fecha = new Date().toISOString();
  var creadoPor = 'Agrupación · ' + (Session.getActiveUser().getEmail() || 'desconocido');

  insertarEtiquetas_([{
    idUnico: idNuevo, numeroPedido: numeroPedido, soporteNum: 1, soporteTotal: 1,
    origen: primero.origen, subtipo: primero.subtipo, origenTexto: primero.origenTexto,
    destino: primero.destino, fechaCreacion: fecha, loteId: Utilities.getUuid(),
    creadoPor: creadoPor, estado: 'REGISTRADO', bateaId: null, fechaEnvio: null,
    origenTienda: primero.origenTienda, razonFlujo: primero.razonFlujo
  }]);

  // Si CUALQUIERA de los originales seguía pendiente de imprimir (INCPC/Preparación),
  // la etiqueta nueva hereda esa bandera — es la que hay que imprimir ahora, ya no las
  // que se van a borrar.
  if (filas.some(function (f) { return f.pendienteImpresionIncpc; })) {
    actualizarEtiquetaCondicional_(idNuevo, { pendienteImpresionIncpc: true });
  }

  // Fase 2 (2026-10-06): el contenido solo de los soportes que se agrupan, no de toda la tabla.
  var mapaContenido = obtenerMapaContenidoDe_(filas.map(function (f) { return f.idUnico; }));
  var contenidoCombinado = [];
  filas.forEach(function (f) {
    (mapaContenido[f.idUnico] || []).forEach(function (item) { contenidoCombinado.push(item); });
  });
  if (contenidoCombinado.length > 0) {
    guardarContenidoSoporte(idNuevo, contenidoCombinado, creadoPor);
  }

  var avisosIncpc = [];
  filas.forEach(function (f) {
    if (String(f.creadoPor || '').indexOf('INCPC · ') === 0) {
      var resultado = notificarAgrupacionAIncpc_(f.idUnico, idNuevo);
      if (!resultado.ok) {
        avisosIncpc.push(f.idUnico + ' → ' + idNuevo + ': no se pudo avisar a INCPC (' + resultado.error + ') — revisa a mano la columna del ID en la hoja de Incidencias.');
      }
    }
  });

  // Bug real (2026-09-23, revisión de seguridad): entre la validación de arriba
  // (validarAgrupacion, sobre una lectura ya algo vieja) y este borrado pasa trabajo
  // no trivial — insertar la etiqueta nueva, copiar contenido, y sobre todo la llamada
  // HTTP síncrona a INCPC por cada original que viniera de esa integración — tiempo de
  // sobra para que un operario escanee uno de los originales seleccionados
  // (escanearSoporte lo marca EN_RUTA con bateaId real) justo antes de que esto lo
  // borre igualmente sin comprobar nada. Ahora se borra condicionado a que el
  // soporte SIGA REGISTRADO (mismo patrón que actualizarEtiquetaCondicional_); si
  // alguno ya se escaneó en el ínterin, se deja quieto (ya viaja en un camión real) y
  // se avisa en vez de borrarlo por debajo del escaneo.
  var noBorrados = [];
  filas.forEach(function (f) {
    var borradas = borrarEtiquetaCondicionalPorIdUnico_(f.idUnico, 'estado=eq.REGISTRADO');
    if (!borradas) noBorrados.push(f.idUnico);
  });
  if (noBorrados.length > 0) {
    avisosIncpc.push('Se escanearon en un camión justo durante la agrupación y NO se borraron (revisa a mano): ' + noBorrados.join(', '));
  }

  return { idUnicoNuevo: idNuevo, numeroPedido: numeroPedido, cantidadOriginal: filas.length, avisosIncpc: avisosIncpc };
}

function actualizarSoporteAdmin(idUnico, cambios) {
  if (!idUnico) throw new Error('Falta el idUnico');
  cambios = cambios || {};
  var filas = leerEtiquetas_('id_unico=eq.' + encodeURIComponent(idUnico));
  if (filas.length === 0) throw new Error('No existe ese soporte: ' + idUnico);
  var actual = filas[0];
  if (actual.estado !== 'REGISTRADO') throw new Error('Solo se puede editar un soporte que aún no se ha cargado en un camión');

  var numeroPedido = String(cambios.numeroPedido !== undefined ? cambios.numeroPedido : actual.numeroPedido).trim();
  if (!numeroPedido) throw new Error('El número de pedido no puede quedar vacío');

  // Bug real (2026-09-23, revisión de seguridad): pedidosPendientesEnCarga empareja
  // soportes hermanos de un pedido multi-soporte por la clave numeroPedido+destino+
  // loteId (Utilidades.gs). Editar numeroPedido o destino de UNA sola fila de un grupo
  // (soporteTotal>1) rompe esa clave para esa fila: deja de emparejar con sus
  // hermanas, y cerrarCarga podría cerrar la carga creyendo que ya no queda nada
  // pendiente aunque la etiqueta editada (impresa con soporteTotal>1) siga sin
  // escanear en ningún sitio. Bloquear en vez de recalcular soporteTotal/loteId aquí:
  // recalcularlo tocaría también a las hermanas no seleccionadas, que esta función no
  // toca — más seguro pedir borrar y volver a registrar ese soporte a mano.
  var tocaNumeroPedido = cambios.numeroPedido !== undefined && numeroPedido !== actual.numeroPedido;
  var tocaDestino = cambios.destino !== undefined && cambios.destino !== actual.destino;
  if (actual.soporteTotal > 1 && (tocaNumeroPedido || tocaDestino)) {
    throw new Error('Este soporte es parte de un pedido con varios soportes (' + actual.soporteNum + '/' + actual.soporteTotal + ') — no se puede cambiar su número de pedido o destino sin descuadrar a sus soportes hermanos. Bórralo y vuelve a registrarlo si hace falta.');
  }

  var origen = cambios.origen !== undefined ? cambios.origen : actual.origen;
  var subtipo = subtipoEfectivo(origen, cambios.subtipo !== undefined ? cambios.subtipo : actual.subtipo);
  var razonFlujo = razonFlujoEfectiva(origen, cambios.razonFlujo !== undefined ? cambios.razonFlujo : actual.razonFlujo);
  var origenTienda = cambios.origenTienda !== undefined ? cambios.origenTienda : actual.origenTienda;
  var destino = cambios.destino !== undefined ? cambios.destino : actual.destino;
  if (!validarTienda(destino)) throw new Error('La tienda destino no es válida');

  if (origen === 'Cesión') {
    var validacionCesion = validarCesionEntreTiendas(origenTienda, destino);
    if (!validacionCesion.ok) throw new Error(mensajeCesionInvalida_(validacionCesion.motivo));
    origenTienda = validarTienda(origenTienda);
  } else {
    origenTienda = '';
  }
  var origenTexto = formatearOrigenTexto(origen, origen === 'Cesión' ? origenTienda : subtipo);

  var actualizadas = actualizarEtiquetaCondicional_(idUnico, {
    numeroPedido: numeroPedido, origen: origen, subtipo: subtipo, origenTienda: origenTienda,
    destino: destino, origenTexto: origenTexto, razonFlujo: razonFlujo
  }, 'estado=eq.REGISTRADO');
  if (actualizadas.length === 0) throw new Error('El soporte cambió de estado justo antes de guardar (ya se cargó en un camión) — recarga y vuelve a intentarlo');
  return actualizadas[0];
}

// ── Cargas de camión (fase 3: escaneo + validación de destino) ──

var PROP_CONTADOR_CARGA = 'HODOS_CONTADOR_CARGA';

function crearCarga(destino, fechaEntrega, horario, cargador) {
  if (!destino) throw new Error('Falta el destino');
  if (!validarTienda(destino)) throw new Error('La tienda destino no es válida: "' + destino + '"');
  if (!fechaEntrega) throw new Error('Falta la fecha de entrega');
  if (!horario) throw new Error('Falta el horario');

  var idCarga = supaRpc_('siguiente_id_carga', {});
  var creadoPor = Session.getActiveUser().getEmail() || 'desconocido';
  insertarCarga_({ idCarga: idCarga, destino: destino, fechaEntrega: fechaEntrega, horario: horario, estado: 'ABIERTA', creadaPor: creadoPor, cargador: cargador || null });
  cachearCargaAbierta_(idCarga, destino);
  return { idCarga: idCarga };
}

function listarCargasAbiertas() {
  return leerCargas_('estado=eq.ABIERTA').map(function (c) {
    return {
      idCarga: c.idCarga,
      destino: c.destino,
      fechaEntrega: fechaComoTexto(c.fechaEntrega),
      horario: c.horario,
      fechaCreacion: fechaComoTexto(c.fechaCreacion)
    };
  });
}

function obtenerOCrearCarga(destino, fechaEntrega, horario, cargadores) {
  // Un camión (destino+fecha+horario) = UNA carga (2026-10-15). Antes solo se buscaba entre las
  // ABIERTAS, así que una vez cerrada la carga de un camión se podía crear otra igual y "cargar
  // varias veces el mismo camión". Ahora se busca en cualquier estado:
  //  - abierta -> se continúa y se anota quién carga;
  //  - cerrada y aún no ha llegado -> NO se reabre sola ni se crea otra: se devuelve marcada
  //    {cerrada:true, reabrible:true} para que la pantalla pida confirmación y llame a reabrirCarga;
  //  - cerrada y ya ha llegado -> igual pero {reabrible:false} (ya no se puede modificar);
  //  - no existe -> se crea.
  // También sirve para "seguir" la carga desde el enlace cruzado de Carta de Portes SIE.
  //
  // Bug real (2026-09-23, revisión de seguridad): leer+decidir+crear sin lock es un
  // check-then-act clásico — dos peticiones casi simultáneas con el mismo
  // destino+fecha+horario podían ver ambas "no existe" y crear dos cargas distintas para el
  // mismo camión. Esta función se llama una vez por camión (no por escaneo), así que un
  // LockService.getScriptLock() aquí es barato y cierra la ventana del todo.
  var quienes = validarCargadores_(cargadores); // sin cargador no se toca nada (ni lock ni consulta)
  if (!destino) throw new Error('Falta el destino');
  if (!validarTienda(destino)) throw new Error('La tienda destino no es válida: "' + destino + '"');
  if (!fechaEntrega) throw new Error('Falta la fecha de entrega');
  if (!horario) throw new Error('Falta el horario');

  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var existentes = leerCargas_('destino=eq.' + encodeURIComponent(destino) +
      '&fecha_entrega=eq.' + encodeURIComponent(fechaEntrega) + '&horario=eq.' + encodeURIComponent(horario));
    // Con varias cargas del mismo camión (datos antiguos) manda la que lleva mercancía (ver elegirCargaExistente_);
    // lo normal es una sola y no hace falta contar nada.
    var contenidos = existentes.length > 1 ? contenidoPorCarga_(existentes) : null;
    var elegida = elegirCargaExistente_(existentes, contenidos);
    if (elegida && elegida.estado === 'ABIERTA') {
      var cargadoresUnidos = unirCargadores_(elegida.cargador, quienes);
      // Solo se escribe si alguien nuevo se anota (continuar la carga con la misma gente no toca la base).
      if (cargadoresUnidos !== String(elegida.cargador || '')) actualizarCarga_(elegida.idCarga, { cargador: cargadoresUnidos });
      return { idCarga: elegida.idCarga, reutilizada: true };
    }
    if (elegida) {
      var llegada = fechaLlegadaCarga_(elegida.fechaEntrega, elegida.horario);
      return {
        idCarga: elegida.idCarga, cerrada: true,
        reabrible: cargaModificablePorLlegada_(elegida, new Date().getTime()),
        destino: elegida.destino, fechaEntrega: fechaComoTexto(elegida.fechaEntrega).split('T')[0], horario: elegida.horario,
        cerradaPor: elegida.cerradaPor || '', fechaCierre: fechaComoTexto(elegida.fechaCierre),
        llegada: llegada == null ? '' : new Date(llegada).toISOString(),
        textoLlegada: textoLlegadaCarga_(elegida)
      };
    }
    var nueva = crearCarga(destino, fechaEntrega, horario, quienes.join(', '));
    return { idCarga: nueva.idCarga, reutilizada: false };
  } finally {
    lock.releaseLock();
  }
}

// Reabre una carga CERRADA para añadir o quitar mercancía (2026-10-15). Solo hasta la hora y día de
// llegada de su camión: pasada esa hora ya no se modifica. Al volver a cerrarla sale un informe
// «ACTUALIZADO» y al B2B de Leroy Merlin solo se le aplica la diferencia (ver cerrarCarga).
function reabrirCarga(idCarga, cargadores) {
  var quienes = validarCargadores_(cargadores);
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var cargas = leerCargas_('id_carga=eq.' + encodeURIComponent(idCarga));
    if (cargas.length === 0) throw new Error('Carga no encontrada: ' + idCarga);
    var c = cargas[0];
    if (c.estado === 'ABIERTA') return { idCarga: idCarga, yaAbierta: true }; // doble clic, o la abrió otra persona
    if (c.estado !== 'CERRADA') throw new Error('La carga ' + idCarga + ' no se puede reabrir (estado ' + c.estado + ').');
    if (!cargaModificablePorLlegada_(c, new Date().getTime())) {
      throw new Error('No se puede reabrir la carga ' + idCarga + ': ya ha pasado su hora de llegada (' + textoLlegadaCarga_(c) + ').');
    }
    var cambios = {
      estado: 'ABIERTA',
      reabiertaPor: Session.getActiveUser().getEmail() || 'desconocido',
      reabiertaEn: new Date().toISOString(),
      cargador: unirCargadores_(c.cargador, quienes)
    };
    // Las cargas cerradas antes de esta mejora no tienen anotado lo que se sumó al B2B: se calcula con
    // sus palets (ya cotejados al cerrar) ANTES de tocarlos, para poder aplicar solo la diferencia luego.
    if (c.b2bConteo == null) {
      var palets = leerPaletesPorCarga_(idCarga);
      if (palets.length) cambios.b2bConteo = conteoSeccionesSie_(palets);
    }
    // PATCH condicionado a que siga CERRADA (mismo patrón que el cierre): si otra ejecución la cambió
    // entre la lectura y la escritura, no se pisa nada.
    var reabierta = actualizarCargaCondicional_(idCarga, cambios, 'estado=eq.CERRADA');
    if (!reabierta) {
      var relectura = leerCargas_('id_carga=eq.' + encodeURIComponent(idCarga));
      if (relectura.length && relectura[0].estado === 'ABIERTA') return { idCarga: idCarga, yaAbierta: true };
      throw new Error('No se pudo reabrir la carga ' + idCarga + ': cambió mientras tanto. Vuelve a intentarlo.');
    }
    // A propósito NO se repuebla el caché de «carga abierta» (ver cachearCargaAbierta_): ese caché solo lo
    // escribe crearCarga y solo lo borra cerrarCarga, y un segundo escritor podría dejarlo diciendo ABIERTA
    // tras un cierre simultáneo desde otro móvil. Sin caché, escanearSoporte lee la carga en fresco (una
    // lectura más por escaneo, solo en cargas reabiertas) y nunca queda un estado incorrecto.
    return { idCarga: idCarga, reabierta: true };
  } finally {
    lock.releaseLock();
  }
}

var TROZO_IDS_CARGAS_PANEL_ = 40; // ids por petición: la URL de UrlFetchApp no admite listas largas (~2 KB)

// Nº de filas de `tabla` (etiquetas o palets) por carga: {idCarga: n}. Solo baja la columna batea_id.
function contarPorCarga_(tabla, ids) {
  var cuenta = {};
  for (var i = 0; i < ids.length; i += TROZO_IDS_CARGAS_PANEL_) {
    var trozo = ids.slice(i, i + TROZO_IDS_CARGAS_PANEL_);
    supaGet_(tabla, 'batea_id=in.(' + trozo.map(encodeURIComponent).join(',') + ')', 'batea_id').forEach(function (f) {
      cuenta[f.batea_id] = (cuenta[f.batea_id] || 0) + 1;
    });
  }
  return cuenta;
}

// Soportes + palets SIE de cada carga de la lista: {idCarga: n}. Solo se usa para decidir entre cargas
// repetidas del mismo camión (ver elegirCargaExistente_).
function contenidoPorCarga_(cargas) {
  var ids = cargas.map(function (c) { return c.idCarga; });
  var soportes = contarPorCarga_('etiquetas', ids);
  var palets = contarPorCarga_('palets', ids);
  var contenidos = {};
  ids.forEach(function (id) { contenidos[id] = (soportes[id] || 0) + (palets[id] || 0); });
  return contenidos;
}

var DIAS_REVISION_CARGAS_ = 7; // hasta cuántos días atrás se buscan cargas que se quedaron sin cerrar
// Solo lo que pinta el panel (no baja pdf_url, b2b_conteo, email_enviado...).
var COLUMNAS_PANEL_CARGAS_ = 'id_carga,destino,fecha_entrega,horario,estado,cargador,fecha_creacion,fecha_cierre,cerrada_por,reabierta_en';

// Pantalla del muelle (2026-10-15): tres listas que NO se mezclan (ver clasificarCargasPanel_):
//   abiertas   = cargas abiertas cuyo camión aún no ha llegado
//   cerradas   = cargas cerradas de hoy en adelante (reabribles hasta la llegada; ya llegado, solo consulta)
//   porRevisar = cargas que se quedaron sin terminar (abiertas con el camión ya llegado y repetidas vacías)
// Un camión (destino+fecha+horario) sale UNA vez: si por datos antiguos tiene varias cargas, manda la que
// abriría obtenerOCrearCarga (la que lleva mercancía). Las cargas cerradas desaparecen de la lista al acabar
// su día de entrega (medianoche, Madrid); las sin terminar siguen en «por revisar» hasta que se cierran o se
// descartan (hasta DIAS_REVISION_CARGAS_ días). El cliente no la repite por sondeo (egress de Supabase): solo
// se cuentan soportes y palets de lo que se ve y de las cargas repetidas.
function listarCargasPanel() {
  var ahora = new Date().getTime();
  var hoy = fechaMadridISO_(ahora);
  var desde = fechaMadridISO_(ahora - DIAS_REVISION_CARGAS_ * 24 * 3600000);
  var filas = leerCargas_('fecha_entrega=gte.' + desde, COLUMNAS_PANEL_CARGAS_);
  var resultado = { abiertas: [], cerradas: [], porRevisar: [] };
  if (filas.length === 0) return resultado;

  var soportes = {};
  var palets = {};
  var contar = function (lista) {
    var ids = lista.map(function (c) { return c.idCarga; });
    var s = contarPorCarga_('etiquetas', ids);
    var p = contarPorCarga_('palets', ids);
    ids.forEach(function (id) { soportes[id] = s[id] || 0; palets[id] = p[id] || 0; });
  };

  // 1) los camiones con más de una carga viva: hace falta saber cuál lleva mercancía para decidir cuál manda
  var porCamion = {};
  filas.forEach(function (c) {
    if (c.estado !== 'ABIERTA' && c.estado !== 'CERRADA') return;
    var k = claveCamionCarga_(c);
    (porCamion[k] = porCamion[k] || []).push(c);
  });
  var repetidas = [];
  Object.keys(porCamion).forEach(function (k) { if (porCamion[k].length > 1) repetidas = repetidas.concat(porCamion[k]); });
  if (repetidas.length) contar(repetidas);
  var contenidos = {};
  Object.keys(soportes).forEach(function (id) { contenidos[id] = soportes[id] + palets[id]; });

  // 2) reparto en las tres listas y recuento de lo que se va a mostrar y aún no está contado
  var clasif = clasificarCargasPanel_(filas, contenidos, ahora, hoy);
  var visibles = clasif.abiertas.concat(clasif.cerradas, clasif.porRevisar.map(function (x) { return x.carga; }));
  var sinContar = visibles.filter(function (c) { return soportes[c.idCarga] === undefined; });
  if (sinContar.length) contar(sinContar);

  var llegadaMs = function (c) { var l = fechaLlegadaCarga_(c.fechaEntrega, c.horario); return l == null ? 0 : l; };
  var dato = function (c) {
    var llegada = fechaLlegadaCarga_(c.fechaEntrega, c.horario);
    var yaLlego = !cargaModificablePorLlegada_(c, ahora);
    var s = soportes[c.idCarga] || 0;
    var p = palets[c.idCarga] || 0;
    return {
      idCarga: c.idCarga, destino: c.destino, fechaEntrega: fechaComoTexto(c.fechaEntrega).split('T')[0], horario: c.horario,
      estado: c.estado, cargador: c.cargador || '',
      fechaCreacion: fechaComoTexto(c.fechaCreacion), fechaCierre: fechaComoTexto(c.fechaCierre), cerradaPor: c.cerradaPor || '',
      soportes: s, palets: p, vacia: s + p === 0,
      llegada: llegada == null ? '' : new Date(llegada).toISOString(),
      yaLlego: yaLlego, reabrible: c.estado === 'CERRADA' && !yaLlego, reabierta: !!c.reabiertaEn
    };
  };
  resultado.abiertas = clasif.abiertas.slice().sort(function (a, b) { return llegadaMs(a) - llegadaMs(b); }).map(dato);
  // cerradas: primero las que aún se pueden reabrir (por hora de llegada) y luego las que ya llegaron (la última, primero)
  resultado.cerradas = clasif.cerradas.slice().sort(function (a, b) {
    var aLlego = !cargaModificablePorLlegada_(a, ahora);
    var bLlego = !cargaModificablePorLlegada_(b, ahora);
    if (aLlego !== bLlego) return aLlego ? 1 : -1;
    return aLlego ? llegadaMs(b) - llegadaMs(a) : llegadaMs(a) - llegadaMs(b);
  }).map(dato);
  resultado.porRevisar = clasif.porRevisar.slice().sort(function (a, b) { return llegadaMs(a.carga) - llegadaMs(b.carga); }).map(function (x) {
    var d = dato(x.carga);
    d.motivo = x.motivo;
    d.principal = x.principal;
    return d;
  });
  return resultado;
}

// Descarta una carga ABIERTA y VACÍA (sin soportes ni palets): la quita de las listas sin enviar ningún informe.
// Sirve para las cargas huérfanas: abiertas por error o repetidas del mismo camión (2026-10-15). Una carga con
// mercancía NO se descarta: hay que cerrarla (así sale su informe). Queda en la tabla con estado DESCARTADA
// (no cuenta como la carga del camión: se puede abrir otra) y con quién y cuándo la descartó en cerrada_por y
// fecha_cierre.
function descartarCarga(idCarga) {
  var lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    var cargas = leerCargas_('id_carga=eq.' + encodeURIComponent(idCarga));
    if (cargas.length === 0) throw new Error('Carga no encontrada: ' + idCarga);
    var c = cargas[0];
    if (c.estado === 'DESCARTADA') return { idCarga: idCarga, yaDescartada: true };
    if (c.estado !== 'ABIERTA') throw new Error('Solo se puede descartar una carga abierta: ' + idCarga + ' está ' + c.estado + '.');
    var sinMercancia = function () { return contenidoPorCarga_([c])[idCarga] === 0; };
    var explicacion = 'No se puede descartar la carga ' + idCarga + ': tiene mercancía. Ábrela y ciérrala para que salga su informe.';
    if (!sinMercancia()) throw new Error(explicacion);
    var hecha = actualizarCargaCondicional_(idCarga, {
      estado: 'DESCARTADA', cerradaPor: Session.getActiveUser().getEmail() || 'desconocido', fechaCierre: new Date().toISOString()
    }, 'estado=eq.ABIERTA');
    if (!hecha) throw new Error('No se pudo descartar la carga ' + idCarga + ': cambió mientras tanto. Vuelve a intentarlo.');
    try {
      CacheService.getScriptCache().remove(claveCacheCarga_(idCarga)); // que ningún escaneo la dé por abierta
    } catch (e) {
      // Ver nota de cachearCargaAbierta_: no debe impedir informar del descarte correcto.
    }
    // Si un escaneo se coló entre contar y descartar, se deshace: una carga con mercancía nunca queda descartada.
    if (!sinMercancia()) {
      actualizarCargaCondicional_(idCarga, { estado: 'ABIERTA', cerradaPor: null, fechaCierre: null }, 'estado=eq.DESCARTADA');
      throw new Error(explicacion);
    }
    return { idCarga: idCarga, descartada: true };
  } finally {
    lock.releaseLock();
  }
}

function obtenerCarga(idCarga) {
  var cargas = leerCargas_('id_carga=eq.' + encodeURIComponent(idCarga));
  if (cargas.length === 0) throw new Error('Carga no encontrada: ' + idCarga);
  var filaCarga = cargas[0];

  // Fase 2 (2026-10-06): el contenido solo de las etiquetas de ESTA carga, no de toda la tabla.
  var filasEscaneadas = leerEtiquetas_('batea_id=eq.' + encodeURIComponent(idCarga));
  var mapaContenidoCarga = obtenerMapaContenidoDe_(filasEscaneadas.map(function (f) { return f.idUnico; }));
  var escaneados = filasEscaneadas
    .map(function (f) {
      return {
        idUnico: f.idUnico, numeroPedido: f.numeroPedido, origenTexto: f.origenTexto,
        fechaEnvio: fechaComoTexto(f.fechaEnvio), contenido: mapaContenidoCarga[f.idUnico] || []
      };
    })
    .sort(function (a, b) { return new Date(a.fechaEnvio) - new Date(b.fechaEnvio); });

  return {
    idCarga: filaCarga.idCarga, destino: filaCarga.destino,
    fechaEntrega: fechaComoTexto(filaCarga.fechaEntrega), horario: filaCarga.horario,
    estado: filaCarga.estado, escaneados: escaneados,
    cargador: filaCarga.cargador || '', reabierta: !!filaCarga.reabiertaEn,
    reabiertaEn: fechaComoTexto(filaCarga.reabiertaEn), reabiertaPor: filaCarga.reabiertaPor || ''
  };
}

var ESCANEO_MAX_REINTENTOS = 5;
var CACHE_TTL_CARGA_SEGUNDOS = 21600; // 6h, el máximo de CacheService

function claveCacheCarga_(idCarga) {
  return 'carga_' + idCarga;
}

// Único punto que ESCRIBE en el caché de "carga abierta" (aparte del borrado en
// cerrarCarga) — se llama solo desde crearCarga, nunca desde escanearSoporte. Esto es
// a propósito, no un descuido: si escanearSoporte pudiera repoblar el caché tras un
// cache-miss, una lectura en curso (leerCargas_ ya en vuelo) podría "resucitar" un
// valor ABIERTA justo después de que cerrarCarga borrara esa entrada — el caché
// quedaría diciendo ABIERTA con un TTL nuevo aunque la carga ya esté CERRADA en
// Supabase, permitiendo escanear soportes que quedarían fuera del PDF/email ya
// enviado. Al escribir una sola vez (en la creación, antes de que exista ningún
// escaneo o cierre para esa idCarga) y borrar solo en cerrarCarga, no hay un segundo
// escritor que pueda competir con el borrado — nunca hay resurrección posible.
// El TTL de 6h es solo red de seguridad por si ese borrado nunca llega a ejecutarse
// (ver cerrarCarga); la garantía real de frescura es el borrado explícito, no el TTL.
function cachearCargaAbierta_(idCarga, destino) {
  try {
    CacheService.getScriptCache().put(claveCacheCarga_(idCarga), JSON.stringify({ destino: destino, estado: 'ABIERTA' }), CACHE_TTL_CARGA_SEGUNDOS);
  } catch (e) {
    // Un fallo aquí no debe romper la creación de la carga: el próximo escaneo
    // simplemente leerá Supabase en fresco (mismo comportamiento que antes de esta
    // optimización), nunca queda en un estado incorrecto.
  }
}

// Evita 1 de las 3 llamadas HTTP por escaneo en el caso común (destino de la carga +
// "¿sigue abierta?"), que es el camino con más llamadas por acción del operario y
// donde más se nota la latencia de red a Supabase. Deliberadamente de solo lectura:
// en un cache-miss (recién invalidado por un cierre, o expulsado por CacheService)
// lee Supabase en fresco pero NUNCA vuelve a escribir en el caché — ver el porqué en
// cachearCargaAbierta_.
function obtenerCargaCacheada_(idCarga) {
  var cacheado = CacheService.getScriptCache().get(claveCacheCarga_(idCarga));
  if (cacheado) return JSON.parse(cacheado);

  var cargas = leerCargas_('id_carga=eq.' + encodeURIComponent(idCarga));
  if (cargas.length === 0) throw new Error('Carga no encontrada: ' + idCarga);
  return { destino: cargas[0].destino, estado: cargas[0].estado };
}

// Concurrencia optimista: dos operarios pueden escanear casi a la vez el mismo
// pedido+destino. En vez de un lock (no hay equivalente barato a LockService contra
// Postgres vía PostgREST), cada intento lee candidatas frescas, decide un ganador con
// la lógica pura de Utilidades.gs, e intenta un PATCH condicionado a que el estado siga
// siendo REGISTRADO. Si el PATCH no afecta ninguna fila, alguien se adelantó entre la
// lectura y la escritura: se reintenta el ciclo completo (relee candidatas ya actualizadas,
// así que la siguiente decisión recae sobre el soporte que de verdad sigue libre).
function escanearSoporte(idCarga, valorEscaneado) {
  valorEscaneado = String(valorEscaneado || '').trim();
  if (!valorEscaneado) throw new Error('Valor escaneado vacío');

  var carga = obtenerCargaCacheada_(idCarga);
  if (carga.estado !== 'ABIERTA') throw new Error('Esta carga ya está cerrada');
  var destinoCarga = carga.destino;

  for (var intento = 0; intento < ESCANEO_MAX_REINTENTOS; intento++) {
    var filtro = (/^HODOS-/.test(valorEscaneado)
      ? 'id_unico=eq.' + encodeURIComponent(valorEscaneado)
      : 'numero_pedido=eq.' + encodeURIComponent(valorEscaneado))
      + '&order=fecha_creacion.asc,id_unico.asc';
    // Orden explícito (con id_unico como desempate): a diferencia de una hoja de Sheets,
    // PostgREST no garantiza el orden de inserción sin ORDER BY. Varios soportes del mismo
    // lote comparten fechaCreacion exacta (registrarLote usa un único timestamp para todo
    // el lote) — id_unico es monótono por orden de creación (secuencia global), así que
    // desempata de forma determinista y preserva el FIFO real entre soportes empatados.
    var candidatas = leerEtiquetas_(filtro);

    var resultado = seleccionarSoporteAEscanear(candidatas, valorEscaneado, destinoCarga);
    if (!resultado.ok) {
      if (resultado.motivo === 'NO_ENCONTRADO' && esFormatoSSCC_(valorEscaneado)) {
        return escanearPaletSSCC_(idCarga, valorEscaneado);
      }
      return resultado;
    }

    // 2026-09-09: pendienteImpresionIncpc (INCPC/Preparación/Arrastres) también se
    // limpia AQUÍ, no solo al pulsar "Imprimir todas" — bug real: un soporte creado
    // por MacroArrastres (origen MECO) se escaneó y cargó en un camión sin haber
    // pasado nunca por el botón de imprimir de su pestaña; el flag se quedó en true
    // para siempre y la etiqueta seguía apareciendo como "pendiente de imprimir"
    // aunque ya estuviera EN_RUTA. Mismo síntoma en Peticiones de Reserva, ahí como
    // "no me deja borrar" (borrarSoporteAdmin exige REGISTRADO). Un soporte que ya se
    // escaneó físicamente ya no tiene sentido que siga "pendiente de imprimir" por
    // definición — si acaba EN_RUTA, se imprimió (o al menos ya no hace falta).
    var actualizadas = actualizarEtiquetaCondicional_(
      resultado.idUnico,
      { estado: 'EN_RUTA', bateaId: idCarga, fechaEnvio: new Date().toISOString(), pendienteImpresionIncpc: false },
      'estado=eq.REGISTRADO'
    );
    if (actualizadas.length > 0) {
      return { ok: true, idUnico: resultado.idUnico, numeroPedido: actualizadas[0].numeroPedido };
    }
    // Alguien más se llevó ese soporte entre la lectura y la escritura: reintentar.
  }
  return { ok: false, motivo: 'REINTENTOS_AGOTADOS' };
}

// Deshace un escaneo dentro de una carga aún abierta (corrección de "me equivoqué de
// pedido/camión"): a diferencia de borrarSoporteAdmin (solo soportes REGISTRADO que
// nunca se cargaron), aquí el soporte SÍ estaba en un camión — se devuelve a
// REGISTRADO en vez de borrarlo, para que siga disponible y se pueda escanear de
// nuevo en la carga correcta. Condicionado a que siga en ESTA carga (batea_id=idCarga)
// por si mientras tanto se movió o la carga ya se cerró.
function quitarSoporteDeCarga(idCarga, idUnico) {
  var carga = obtenerCargaCacheada_(idCarga);
  if (carga.estado !== 'ABIERTA') throw new Error('Esta carga ya está cerrada');
  var actualizadas = actualizarEtiquetaCondicional_(
    idUnico,
    { estado: 'REGISTRADO', bateaId: null, fechaEnvio: null },
    'batea_id=eq.' + encodeURIComponent(idCarga)
  );
  if (actualizadas.length === 0) throw new Error('No se encontró ese soporte en esta carga');
  return { ok: true };
}

// Las filas que de verdad miran pedidosPendientesEnCarga y soportesMecoPendientesEnCarga
// (Utilidades.gs): (a) las etiquetas cargadas en ESTA carga (bateaId === idCarga) y (b)
// las que siguen REGISTRADO (aún sin cargar). Cualquier otra fila (ya EN_RUTA en otra
// carga, de otro estado) no entra en ninguna de las dos cuentas, así que el resultado
// es EXACTAMENTE el mismo que con la tabla entera. Solo las 9 columnas que usa el cierre,
// sin duplicados y en el mismo orden (id_unico asc) que la lectura entera de antes.
function leerEtiquetasParaChequeoCierre_(idCarga) {
  var COLUMNAS = 'id_unico,numero_pedido,origen,origen_texto,destino,estado,batea_id,soporte_total,lote_id';
  var enCarga = leerEtiquetas_('batea_id=eq.' + encodeURIComponent(idCarga) + '&order=id_unico.asc', COLUMNAS);
  var registradas = leerEtiquetas_('estado=eq.REGISTRADO&order=id_unico.asc', COLUMNAS);
  var vistos = {};
  var todas = [];
  enCarga.concat(registradas).forEach(function (f) {
    var k = String(f.idUnico);
    if (!vistos[k]) { vistos[k] = true; todas.push(f); }
  });
  todas.sort(function (a, b) { return String(a.idUnico) < String(b.idUnico) ? -1 : (String(a.idUnico) > String(b.idUnico) ? 1 : 0); });
  return todas;
}

function cerrarCarga(idCarga, forzar) {
  var cargas = leerCargas_('id_carga=eq.' + encodeURIComponent(idCarga));
  if (cargas.length === 0) throw new Error('Carga no encontrada: ' + idCarga);
  if (cargas[0].estado !== 'ABIERTA') throw new Error('Esta carga ya está cerrada');

  // order=id_unico.asc: ver nota igual en buscarEtiquetas — orden estable entre
  // páginas frente a un borrado concurrente mientras se pagina la tabla completa.
  // Fase 2 (2026-10-06): ya no se baja la tabla entera (~6.200 filas) en cada cierre:
  // las dos comprobaciones de abajo solo miran las etiquetas de ESTA carga y las que
  // siguen REGISTRADO (ver leerEtiquetasParaChequeoCierre_).
  var filasChk = leerEtiquetasParaChequeoCierre_(idCarga).map(function (f) {
    return {
      idUnico: f.idUnico, numeroPedido: f.numeroPedido, origen: f.origen, origenTexto: f.origenTexto,
      destino: f.destino, estado: f.estado, bateaId: f.bateaId,
      // soporteTotal/loteId: pedidosPendientesEnCarga (Utilidades.gs) los necesita para
      // saber si dos filas son de verdad soportes hermanos de un pedido declarado
      // multi-soporte, o solo una coincidencia de numeroPedido entre registros
      // independientes (ver comentario en esa función).
      soporteTotal: f.soporteTotal, loteId: f.loteId
    };
  });

  var mensajesBloqueo = [];

  var pendientes = pedidosPendientesEnCarga(filasChk, idCarga);
  if (pendientes.length > 0) {
    // Se lista cada soporte que falta con su ID único y origen (no solo el número de
    // pedido y un recuento) para que se pueda buscar exactamente esa fila en el
    // Buscador Interno — si resulta ser un dato suelto que no debería contar, desde
    // ahí mismo se puede editar/borrar (mientras siga REGISTRADO).
    var detallePedidos = pendientes.map(function (p) {
      var detalleSoportes = p.soportes.map(function (s) {
        return s.idUnico + ' (' + (s.origenTexto || 'origen desconocido') + ')';
      }).join(', ');
      return p.numeroPedido + ': faltan ' + p.soportesPendientes + ' soporte(s) — ' + detalleSoportes;
    }).join('\n');
    mensajesBloqueo.push('hay pedidos incompletos:\n' + detallePedidos);
  }

  // El origen MECO se carga siempre completo por tienda (ver soportesMecoPendientesEnCarga
  // en Utilidades.gs): si esta carga ya lleva algún soporte MECO de una tienda, no puede
  // cerrarse mientras queden otros soportes MECO de esa misma tienda sin cargar.
  var pendientesMeco = soportesMecoPendientesEnCarga(filasChk, idCarga);
  if (pendientesMeco.length > 0) {
    var detalleMeco = pendientesMeco.map(function (p) { return p.idUnico + ' (pedido ' + p.numeroPedido + ')'; }).join(', ');
    mensajesBloqueo.push('el origen MECO debe cargarse completo para esta tienda — faltan ' + pendientesMeco.length + ' soporte(s) por cargar: ' + detalleMeco);
  }

  var forzado = false;
  if (mensajesBloqueo.length > 0) {
    if (!forzar) {
      throw new Error('No se puede cerrar la carga: ' + mensajesBloqueo.join(' · '));
    }
    // Cierre forzado — función oculta (pulsación larga de 2s sobre "Cerrar carga" +
    // confirmación explícita), se salta las validaciones a propósito. Queda constancia
    // en el log y en el resumen devuelto al cliente (avisosOmitidos), nunca en silencio.
    forzado = true;
    Logger.log('cerrarCarga FORZADO (' + idCarga + '), saltando validaciones: ' + mensajesBloqueo.join(' · '));
  }

  // Bug real (2026-09-23, revisión de seguridad): antes, el cierre se escribía en
  // Supabase AL FINAL, después de generar el PDF y mandar el email real (I/O lenta,
  // varios segundos: conversión a PDF vía Drive + MailApp.sendEmail). Eso abría dos
  // huecos: (1) dos cierres casi simultáneos (doble clic, dos operarios) pasaban
  // ambos el check ABIERTA de arriba y ambos generaban informe + email real +
  // escritura en el B2B externo de Leroy Merlin antes de que ninguno marcara
  // CERRADA; (2) un escaneo que llegara durante esa ventana quedaba EN_RUTA con
  // éxito pero nunca aparecía en el PDF/email ya generados — soporte "fantasma".
  // Ahora se reclama el cierre AQUÍ, antes de cualquier I/O lenta, con el mismo
  // patrón de concurrencia optimista que ya usa escanearSoporte: PATCH condicionado
  // a que la carga siga ABIERTA. Si otra ejecución ya la cerró entre la lectura de
  // arriba y este punto, esto devuelve null y abortamos sin generar nada dos veces.
  // El caché se borra justo después (no al final) para que cualquier escanearSoporte
  // que llegue a partir de aquí vea la carga cerrada en cuanto relea Supabase —
  // reduce la ventana del soporte fantasma a la concurrencia real (sub-segundo)
  // entre esta escritura y el borrado de caché, no a los varios segundos de PDF+email
  // (la TOCTOU residual de ese margen mínimo ya está aceptada en CLAUDE.md/spec de
  // migración, igual que antes de este fix).
  var cerradaPor = Session.getActiveUser().getEmail() || 'desconocido';
  var reclamada = actualizarCargaCondicional_(idCarga, {
    estado: 'CERRADA', cerradaPor: cerradaPor, fechaCierre: new Date().toISOString()
  }, 'estado=eq.ABIERTA');
  if (!reclamada) throw new Error('Esta carga ya está cerrada');
  try {
    CacheService.getScriptCache().remove(claveCacheCarga_(idCarga));
  } catch (e) {
    // Ver nota de cachearCargaAbierta_: no debe impedir informar del cierre correcto.
  }

  var carga = obtenerCarga(idCarga);

  // Carga reabierta (2026-10-15): el informe sale marcado «ACTUALIZADO» y el B2B recibe solo la
  // diferencia con lo que ya se aplicó en el cierre anterior (ver actualizarB2BSIE_).
  var reabierta = !!cargas[0].reabiertaEn;
  var conteoPrevio = (cargas[0].b2bConteo && typeof cargas[0].b2bConteo === 'object') ? cargas[0].b2bConteo : null;
  var hayConteoPrevio = !!conteoPrevio && Object.keys(conteoPrevio).some(function (k) { return (Number(conteoPrevio[k]) || 0) !== 0; });

  // Fusión Carta de Portes SIE (2026-09-15): si esta carga tiene palets refill,
  // cotejarlos contra el inventario del día ANTES de generar el informe (para que
  // salgan con sección/código LM), y anotar el resultado para el B2B y el email.
  var cotejoSie = cotejarPaletesDeCarga_(idCarga, carga.destino);
  if (!cotejoSie.ok) Logger.log('AVISO cotejo SIE en cerrarCarga: ' + cotejoSie.error);
  var tienePaletsSie = cotejoSie.ok && cotejoSie.datos.length > 0;

  var htmlPdf = htmlInformeCarga(idCarga);
  var fechaArchivo = carga.fechaEntrega.split('T')[0];

  // Sin copia permanente en Drive (2026-08-04): el archivo temporal sigue siendo
  // necesario porque Apps Script solo sabe convertir HTML a PDF a través de un archivo
  // de Drive, pero se borra igual que antes — pdfFile (el blob PDF resultante) se usa
  // directamente como adjunto de MailApp y nunca se guarda con createFile().
  var tempFile = DriveApp.getRootFolder().createFile('_temp_hodos_informe.html', htmlPdf, 'text/html');
  var pdfFile = tempFile.getAs('application/pdf');
  pdfFile.setName('HODOS_InformeCarga_' + carga.destino + '_' + fechaArchivo + '_' + idCarga + '.pdf');
  DriveApp.getFileById(tempFile.getId()).setTrashed(true);

  // El cuerpo del email es el mismo HTML que el PDF, pero con el logo como imagen
  // inline (CID) en vez de data:URI — los clientes de correo (Gmail, Outlook) suelen
  // bloquear imágenes en base64 incrustadas en el cuerpo, aunque el PDF adjunto las
  // muestre bien (esa conversión pasa por Drive, no por el motor del cliente de correo).
  var htmlEmail = htmlPdf.replace('data:image/png;base64,' + LOGO_TAISA_B64, 'cid:logoTaisa');
  var logoInline = Utilities.newBlob(Utilities.base64Decode(LOGO_TAISA_B64), 'image/png', 'logo_taisa.png');

  var destinatarios = tienePaletsSie
    ? unirListasEmail_(EMAILS_PEDIDO_CLIENTE_TIENDA[carga.destino] || [], EMAILS_CARTA_TIENDA[carga.destino] || [])
    : (EMAILS_PEDIDO_CLIENTE_TIENDA[carga.destino] || []);
  var ccEnvio = tienePaletsSie
    ? unirListasEmail_(EMAILS_PEDIDO_CLIENTE_CC, EMAILS_CARTA_CC)
    : EMAILS_PEDIDO_CLIENTE_CC;
  var emailEnviado = 'NO';
  if (modoPruebaActivo()) {
    emailEnviado = 'MODO_PRUEBA (no enviado)';
  } else if (destinatarios.length > 0) {
    try {
      MailApp.sendEmail({
        to: destinatarios.join(','),
        cc: ccEnvio.join(','),
        subject: 'HODOS · Informe de carga' + (reabierta ? ' ACTUALIZADO' : '') + ' · ' + carga.destino + ' · ' + fechaArchivo + (carga.horario ? ' · ' + carga.horario : ''),
        htmlBody: htmlEmail,
        attachments: [pdfFile],
        inlineImages: { logoTaisa: logoInline }
      });
      emailEnviado = 'SI';
    } catch (e) {
      emailEnviado = 'ERROR: ' + e.message;
    }
  }

  // Fusión Carta de Portes SIE: escritura en el B2B externo de Leroy Merlin, igual
  // que hacía CartadePortesSIE — independiente del email (try/catch propio dentro
  // de actualizarB2BSIE_), solo si esta carga trae palets refill.
  var resultadoB2B = null;
  // También se vuelve a escribir cuando ya no queda ningún palet pero antes se aplicó algo (carga
  // reabierta a la que se quitaron todos): así se resta lo ya sumado. Nunca si el cotejo falló (los
  // palets siguen ahí aunque no se pudieran contar: restar sería un error).
  if (cotejoSie.ok && (tienePaletsSie || hayConteoPrevio) && carga.horario) {
    var partesFechaB2B = carga.fechaEntrega.split('T')[0].split('-');
    var fechaB2B = partesFechaB2B[2] + '/' + partesFechaB2B[1] + '/' + partesFechaB2B[0];
    resultadoB2B = actualizarB2BSIE_(carga.destino, fechaB2B, carga.horario, tienePaletsSie ? cotejoSie.datos : [], conteoPrevio);
  }

  // El cierre en sí (estado=CERRADA) ya quedó escrito arriba, ANTES del PDF/email —
  // esto solo añade el campo informativo emailEnviado a la misma fila. Si esto
  // fallara (red inestable), la carga sigue correctamente CERRADA; solo se pierde
  // ese campo descriptivo, nunca una escritura incorrecta ni un reenvío del informe.
  var cambiosFinales = { emailEnviado: emailEnviado };
  // Lo que esta carga ya tiene sumado en el B2B: el próximo cierre aplicará solo la diferencia.
  if (resultadoB2B && resultadoB2B.ok && resultadoB2B.conteo) cambiosFinales.b2bConteo = resultadoB2B.conteo;
  try {
    actualizarCarga_(idCarga, cambiosFinales);
  } catch (e) {
    Logger.log('AVISO: no se pudo guardar emailEnviado en cerrarCarga (' + idCarga + '): ' + e.message);
  }

  // Bug real (2026-09-23, revisión de seguridad): un fallo en el cotejo de inventario
  // SIE o en la escritura del B2B externo antes solo iba a Logger.log — la carga
  // cerraba "OK" en pantalla, el email podía salir, y nadie se enteraba de que el
  // documento de Leroy Merlin se quedó sin actualizar. Ahora se devuelve como aviso
  // (mismo patrón que avisosIncpc en agruparSoportesAdmin) para que Index.html lo
  // muestre en el resumen de cierre en vez de quedar solo en el log del editor.
  var avisosSie = [];
  if (!cotejoSie.ok) avisosSie.push('Cotejo de inventario SIE: ' + cotejoSie.error);
  if (resultadoB2B && !resultadoB2B.ok) avisosSie.push('Escritura en B2B Leroy Merlin: ' + resultadoB2B.error);
  else if (resultadoB2B && resultadoB2B.aviso) avisosSie.push(resultadoB2B.aviso);

  return {
    idCarga: idCarga, cantidad: carga.escaneados.length,
    emailEnviado: emailEnviado, destinatariosConfigurados: destinatarios.length,
    forzado: forzado, avisosOmitidos: forzado ? mensajesBloqueo : [],
    avisosSie: avisosSie, reabierta: reabierta
  };
}
